# Dockerfile HÍBRIDO para InvoiceNinja
# Baixa o release oficial para pegar o React compilado
# Depois aplica TODAS as suas customizações do código-fonte
# Use este para manter customizações + React funcionando

FROM php:8.2-fpm

# Variáveis de ambiente
ENV DEBIAN_FRONTEND=noninteractive \
    PHP_MEMORY_LIMIT=512M \
    PHP_UPLOAD_MAX_FILESIZE=50M \
    PHP_POST_MAX_SIZE=50M \
    INVOICENINJA_VERSION=latest

# Instalar dependências do sistema
RUN apt-get update && apt-get install -y \
    git \
    curl \
    wget \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    libzip-dev \
    zip \
    unzip \
    libfreetype6-dev \
    libjpeg62-turbo-dev \
    libicu-dev \
    libcurl4-openssl-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Instalar extensões PHP necessárias
RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
    pdo_mysql \
    mysqli \
    bcmath \
    gd \
    mbstring \
    xml \
    zip \
    intl \
    opcache

# Instalar Redis extension
RUN pecl install redis && docker-php-ext-enable redis

# Instalar Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Configurar diretório de trabalho
WORKDIR /var/www/html

# ============================================
# ETAPA 1: Baixar release oficial (para pegar React compilado)
# ============================================
RUN if [ "$INVOICENINJA_VERSION" = "latest" ]; then \
        LATEST_VERSION=$(curl -s https://api.github.com/repos/invoiceninja/invoiceninja/releases/latest | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/') || LATEST_VERSION="latest"; \
        DOWNLOAD_URL="https://github.com/invoiceninja/invoiceninja/releases/download/${LATEST_VERSION}/invoiceninja.tar.gz"; \
    else \
        DOWNLOAD_URL="https://github.com/invoiceninja/invoiceninja/releases/download/${INVOICENINJA_VERSION}/invoiceninja.tar.gz"; \
    fi \
    && echo "Baixando InvoiceNinja de: $DOWNLOAD_URL" \
    && curl -L --fail --retry 3 --max-time 300 -o /tmp/invoiceninja.tar.gz "$DOWNLOAD_URL" \
    && mkdir -p /tmp/invoiceninja-extract \
    && tar -xzf /tmp/invoiceninja.tar.gz -C /tmp/invoiceninja-extract \
    && rm /tmp/invoiceninja.tar.gz \
    && cd /tmp/invoiceninja-extract \
    && if [ -d invoiceninja ]; then \
        cp -R invoiceninja/* /var/www/html/; \
    else \
        EXTRACT_DIR=$(find . -maxdepth 1 -type d -name "invoiceninja*" | head -1); \
        if [ -n "$EXTRACT_DIR" ]; then \
            cp -R "$EXTRACT_DIR"/* /var/www/html/; \
        else \
            cp -R . /var/www/html/; \
        fi; \
    fi \
    && rm -rf /tmp/invoiceninja-extract \
    && echo "Release oficial baixado com sucesso!"

# ============================================
# ETAPA 2: Verificar arquivos React do release
# ============================================
# Verificar se React está presente no release (não precisa fazer backup porque .dockerignore preserva)
RUN echo "=== Verificando React no release ===" && \
    if [ -d /var/www/html/public/react ]; then \
        echo "✅ React encontrado em /var/www/html/public/react"; \
        find /var/www/html/public/react -type f | wc -l | xargs echo "Arquivos:"; \
        du -sh /var/www/html/public/react; \
    else \
        echo "⚠️  React não encontrado em /var/www/html/public/react"; \
    fi && \
    if [ -d /var/www/html/resources/views/react ]; then \
        echo "✅ resources/views/react encontrado"; \
        ls -la /var/www/html/resources/views/react; \
    else \
        echo "⚠️  resources/views/react não encontrado"; \
    fi

# ============================================
# ETAPA 3: Aplicar TODAS as customizações do código-fonte
# ============================================
# Copiar TODOS os arquivos do código-fonte
# O .dockerignore já ignora public/ inteira, então ela será preservada do release
#
# NOTA: O .dockerignore já filtra:
# - node_modules/
# - .git/
# - storage/logs/
# - public/ (TODA a pasta é ignorada para preservar o do release)
# etc.

# Copiar arquivos do projeto
# IMPORTANTE: Não copiar public/ do código-fonte para preservar o do release
COPY composer.json composer.lock* ./
COPY package.json ./

# Copiar arquivos do projeto
# O .dockerignore já filtra public/ e resources/views/react/, então eles serão preservados do release
COPY composer.json composer.lock* ./
COPY package.json ./
COPY . .

# O .dockerignore garante que public/ e resources/views/react/ não sejam copiados
# Então eles permanecem intactos do release oficial

# Verificar React após COPY (deve estar preservado pelo .dockerignore)
RUN echo "=== Verificando React após COPY ===" && \
    if [ -d /var/www/html/public/react ]; then \
        echo "✅ public/react/ preservado"; \
        find /var/www/html/public/react -type f | wc -l | xargs echo "Arquivos:"; \
        du -sh /var/www/html/public/react; \
        echo "Estrutura de public/react/:"; \
        ls -la /var/www/html/public/react/ | head -10; \
    else \
        echo "❌ ERRO: public/react/ não encontrado após COPY!"; \
    fi

# Gerar head.blade.php automaticamente baseado nos arquivos React encontrados
RUN echo "=== Gerando head.blade.php ===" && \
    if [ -d /var/www/html/public/react ]; then \
        echo "Procurando arquivos React..."; \
        REACT_BASE="/var/www/html/public/react"; \
        VERSION_DIR=$(find "$REACT_BASE" -maxdepth 1 -type d -name "v*" 2>/dev/null | head -1); \
        if [ -n "$VERSION_DIR" ]; then \
            REACT_DIR="$VERSION_DIR"; \
            VERSION_PATH=$(basename "$VERSION_DIR"); \
            echo "Encontrado diretório versionado: $VERSION_PATH"; \
        else \
            REACT_DIR="$REACT_BASE"; \
            VERSION_PATH=""; \
            echo "Usando diretório base: $REACT_DIR"; \
        fi && \
        JS_FILES=$(find "$REACT_DIR" -type f -name "*.js" 2>/dev/null | wc -l); \
        CSS_FILES=$(find "$REACT_DIR" -type f -name "*.css" 2>/dev/null | wc -l); \
        echo "Encontrados: $JS_FILES arquivos JS, $CSS_FILES arquivos CSS" && \
        if [ "$JS_FILES" -eq 0 ]; then \
            echo "⚠️  Nenhum arquivo JS encontrado em $REACT_DIR"; \
            echo "Listando estrutura:"; \
            find "$REACT_BASE" -type f | head -20; \
        else \
            INCLUDES="" && \
            for file in $(find "$REACT_DIR" -type f -name "*.js" 2>/dev/null | sort); do \
                filename=$(basename "$file"); \
                if [ -n "$VERSION_PATH" ]; then \
                    path="/react/$VERSION_PATH/$filename"; \
                else \
                    path="/react/$filename"; \
                fi && \
                if echo "$filename" | grep -q "index-"; then \
                    INCLUDES="${INCLUDES}<script type=\"module\" crossorigin src=\"${path}\"></script>\n"; \
                else \
                    INCLUDES="${INCLUDES}<link rel=\"modulepreload\" href=\"${path}\">\n"; \
                fi; \
            done && \
            for file in $(find "$REACT_DIR" -type f -name "*.css" 2>/dev/null | sort); do \
                filename=$(basename "$file"); \
                if [ -n "$VERSION_PATH" ]; then \
                    path="/react/$VERSION_PATH/$filename"; \
                else \
                    path="/react/$filename"; \
                fi && \
                INCLUDES="${INCLUDES}<link rel=\"stylesheet\" href=\"${path}\">\n"; \
            done && \
            mkdir -p /var/www/html/resources/views/react && \
            echo -e "$INCLUDES" > /var/www/html/resources/views/react/head.blade.php && \
            chown www-data:www-data /var/www/html/resources/views/react/head.blade.php && \
            chmod 644 /var/www/html/resources/views/react/head.blade.php && \
            FILE_SIZE=$(wc -c < /var/www/html/resources/views/react/head.blade.php); \
            if [ "$FILE_SIZE" -gt 0 ]; then \
                echo "✅ head.blade.php gerado com sucesso! ($FILE_SIZE bytes)"; \
                echo "Primeiras 5 linhas:"; \
                head -5 /var/www/html/resources/views/react/head.blade.php; \
            else \
                echo "❌ ERRO: head.blade.php está vazio!"; \
            fi; \
        fi; \
    else \
        echo "❌ ERRO: public/react/ não encontrado!"; \
    fi

# ============================================
# ETAPA 4: Configurações finais
# ============================================

# Configurar permissões
RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 755 /var/www/html/storage \
    && chmod -R 755 /var/www/html/bootstrap/cache

# Configurar PHP-FPM
RUN sed -i 's/listen = 127.0.0.1:9000/listen = 9000/' /usr/local/etc/php-fpm.d/www.conf \
    && sed -i 's/;listen.owner = www-data/listen.owner = www-data/' /usr/local/etc/php-fpm.d/www.conf \
    && sed -i 's/;listen.group = www-data/listen.group = www-data/' /usr/local/etc/php-fpm.d/www.conf \
    && sed -i 's/user = www-data/user = www-data/' /usr/local/etc/php-fpm.d/www.conf \
    && sed -i 's/group = www-data/group = www-data/' /usr/local/etc/php-fpm.d/www.conf

# Configurar PHP.ini
RUN echo "memory_limit = ${PHP_MEMORY_LIMIT}" > /usr/local/etc/php/conf.d/memory.ini \
    && echo "upload_max_filesize = ${PHP_UPLOAD_MAX_FILESIZE}" > /usr/local/etc/php/conf.d/uploads.ini \
    && echo "post_max_size = ${PHP_POST_MAX_SIZE}" >> /usr/local/etc/php/conf.d/uploads.ini \
    && echo "max_execution_time = 300" > /usr/local/etc/php/conf.d/execution.ini \
    && echo "max_input_time = 300" >> /usr/local/etc/php/conf.d/execution.ini

# Configurar OPcache para produção
RUN echo "opcache.enable=1" > /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.memory_consumption=128" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.interned_strings_buffer=8" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.max_accelerated_files=10000" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.revalidate_freq=2" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.fast_shutdown=1" >> /usr/local/etc/php/conf.d/opcache.ini

# Script de inicialização
# Copiar docker-entrypoint.sh para /usr/local/bin/ (que está no PATH)
# Isso garante que o ENTRYPOINT encontre o arquivo
# Copiamos DEPOIS do COPY . . para usar nossa versão customizada
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh \
    && sed -i 's/\r$//' /usr/local/bin/docker-entrypoint.sh \
    && echo "docker-entrypoint.sh copiado e processado"

# Expor porta do PHP-FPM
EXPOSE 9000

# ENTRYPOINT usa caminho completo para garantir que funcione
ENTRYPOINT ["/bin/bash", "/usr/local/bin/docker-entrypoint.sh"]
CMD ["php-fpm"]
